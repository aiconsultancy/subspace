IRC_SERVER_NAME=irc.localhost
IRC_ENABLE_PLAIN=true
IRC_ENABLE_WS=true
IRC_PLAIN_BIND=127.0.0.1
IRC_PLAIN_PORT=6667
IRC_TLS_BIND=127.0.0.1
IRC_TLS_PORT=6697
IRC_WS_BIND=127.0.0.1
IRC_WS_PORT=8097
IRC_WS_ORIGIN=
IRC_BCRYPT_COST=12
IRC_TLS_CERT=
IRC_TLS_KEY=

# Set an operator name and supply its password or password file.
IRC_OPER_NAME=
IRC_OPER_PASSWORD=
IRC_OPER_PASSWORD_FILE=

# Set one seed source if you need service accounts.
IRC_ACCOUNTS_JSON=
IRC_ACCOUNTS_FILE=

# Set one seed source if you want channels registered at startup.
IRC_CHANNELS_JSON=
IRC_CHANNELS_FILE=
IRC_CHANNEL_FOUNDER=

# Optional sign-in through the Subspace API. Set the URL and one token source.
IRC_AUTH_API_URL=
IRC_AUTH_API_TOKEN_FILE=
IRC_AUTH_API_TOKEN=
IRC_AUTH_API_CA_FILE=
IRC_AUTH_PASSPHRASE_PREFIX=
