network:
    name: Subspace

server:
    name: @@SERVER_NAME@@
    listeners:
@@LISTENERS@@
    sts:
        enabled: false
    websockets:
        allowed-origins: @@WS_ORIGINS@@
    casemapping: ascii
    enforce-utf8: true
    lookup-hostnames: false
    coerce-ident: "~u"
    motd: /ircd-bin/subspace.motd
    motd-formatting: true
    idle-timeouts:
        registration: 60s
        ping: 90s
        disconnect: 150s
    relaymsg:
        enabled: true
        separators: "/"
        available-to-chanops: true
    max-sendq: 96k
    compatibility:
        force-trailing: true
        send-unprefixed-sasl: true
        allow-truncation: false
    # Container port forwarding and TLS proxies can collapse clients onto one IP.
    ip-limits:
        count: false
        throttle: false
    ip-cloaking:
        enabled: true
        enabled-for-always-on: true
        netname: irc
        cidr-len-ipv4: 32
        cidr-len-ipv6: 64
        num-bits: 64
    oper-throttle: 10s

accounts:
    authentication-enabled: true
    registration:
        enabled: false
        bcrypt-cost: @@BCRYPT_COST@@
    login-throttling:
        enabled: true
        duration: 1m
        max-attempts: 3
    advertise-scram: true
    require-sasl:
        enabled: true
    # Sign-in through the Subspace API, rendered only when IRC_AUTH_API_URL is set.
@@AUTH_SCRIPT@@
    nick-reservation:
        enabled: true
        additional-nick-limit: 0
        method: strict
        allow-custom-enforcement: false
        guest-nickname-format: "Guest-*"
        force-nick-equals-account: true
    multiclient:
        enabled: true
        allowed-by-default: true
        always-on: opt-in
        auto-away: opt-in
    vhosts:
        enabled: true
        max-length: 64
        valid-regexp: '^[0-9A-Za-z.\-_/]+$'
    default-user-modes: +i

channels:
    default-modes: +ntC
    max-channels-per-client: 100
    operator-only-creation: true
    registration:
        enabled: true
        operator-only: true
        max-channels-per-account: 15
    invite-expiration: 24h

oper-classes:
    chat-moderator:
        title: Chat Moderator
        capabilities: [kill, ban, nofakelag, relaymsg, vhosts, sajoin, samode, snomasks]
    server-admin:
        title: Server Admin
        extends: chat-moderator
        capabilities: [rehash, accreg, chanreg, history, defcon, massmessage, metadata]
opers: @@OPERS@@

logging:
    - method: stderr
      type: "* -userinput -useroutput"
      level: info
debug:
    recover-from-errors: true

# Ergo's auth-script does not work with environment overrides (ergochat/ergo#2275).
allow-environment-overrides: false

lock-file: /ircd/ircd.lock
datastore:
    path: /ircd/ircd.db
    autoupgrade: true
@@HISTORY_DATABASE@@

languages:
    enabled: true
    default: en
    path: /ircd-bin/languages

limits:
    nicklen: 32
    identlen: 20
    realnamelen: 150
    channellen: 64
    awaylen: 390
    kicklen: 390
    topiclen: 390
    monitor-entries: 100
    whowas-entries: 100
    chan-list-modes: 100
    registration-messages: 1024
    multiline:
        max-bytes: 4096
        max-lines: 100
fakelag:
    enabled: true
    window: 1s
    burst-limit: 5
    messages-per-window: 2
    cooldown: 2s
    command-budgets: {CHATHISTORY: 16, MARKREAD: 16, MONITOR: 1, WHO: 4, WEBPUSH: 1}

history:
    enabled: true
    channel-length: 2048
    client-length: 256
    autoresize-window: 3d
    autoreplay-on-join: 0
    chathistory-maxmessages: 1000
    znc-maxmessages: 2048
    restrictions:
        expire-time: 2160h
        query-cutoff: none
    persistent:
        enabled: true
        unregistered-channels: false
        registered-channels: opt-out
        direct-messages: opt-out
    tagmsg-storage:
        default: false
        whitelist: ["+draft/react", "+draft/unreact", "+react"]

metadata:
    enabled: true
    max-subs: 100
    max-keys: 100
    client-throttle:
        enabled: true
        duration: 2m
        max-attempts: 20
