{
  "version": 1,
  "id": "native-demo",
  "title": "Simulated live dashboard",
  "environment": "python-default",
  "entrypoint": "main.py",
  "inputs": {
    "rate": {"type": "number", "default": 1.0, "min": 0.1, "max": 5.0, "step": 0.1},
    "mode": {"type": "string", "default": "Running", "options": ["Running", "Paused"]}
  },
  "components": [
    {
      "id": "root",
      "label": "Dashboard",
      "kind": {
        "type": "column",
        "children": [
          {"id": "summary", "label": "Simulated summary", "kind": {"type": "text", "text": "SIMULATED data. Start to begin."}},
          {"id": "rate", "label": "Update interval (seconds)", "kind": {"type": "slider", "input": "rate"}},
          {"id": "mode", "label": "Updates", "kind": {"type": "select", "input": "mode"}},
          {"id": "reset", "label": "Reset history", "kind": {"type": "button", "action": "reset"}},
          {"id": "utilization", "label": "SIMULATED CPU utilization", "kind": {"type": "chart"}},
          {"id": "history", "label": "SIMULATED CPU history", "kind": {"type": "chart"}},
          {"id": "memory", "label": "SIMULATED RAM history", "kind": {"type": "chart"}},
          {"id": "comparison", "label": "SIMULATED utilization comparison", "kind": {"type": "chart"}},
          {"id": "rows", "label": "SIMULATED sample history", "kind": {"type": "table"}}
        ]
      }
    }
  ],
  "actions": ["reset"],
  "environment_keys": [],
  "destinations": [],
  "files": ["main.py"]
}
