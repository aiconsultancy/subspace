{
  "name": "Subspace One Dark",
  "mode": "dark",
  "radius": 6,
  "radius.lg": 8,
  "subspace": {
    "version": 1,
    "density": {
      "--toolbar-button-h": "24px",
      "--toolbar-button-pad-x": "10px",
      "--toolbar-button-font": "13px",
      "--toolbar-button-radius": "12px",
      "--action-button-h": "20px",
      "--action-button-pad-x": "8px",
      "--action-button-font": "11px",
      "--action-button-radius": "6px",
      "--dialog-button-h": "24px",
