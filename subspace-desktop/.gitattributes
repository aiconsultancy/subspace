# Check out text files with LF on every platform. Git for Windows converts to
# CRLF by default, and the crates embed files with include_str!, such as the
# themes in framework/host/app/themes, whose content must not depend on the machine
# that built the binary.
* text=auto eol=lf

# Retain the blank line's space from the upstream QuickJS NG licence.
licenses/charts/LICENSE-QUICKJS-NG whitespace=-blank-at-eol

# Preserve the exact upstream licence bytes used by the release checks.
licenses/onnxruntime/LICENSE -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
licenses/onnxruntime/ThirdPartyNotices.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
licenses/rust-crates/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
licenses/webview2/*.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
licenses/fonts/LICENSE-* -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Embedded font files are binary: no line-ending conversion or text diff.
*.ttf binary
