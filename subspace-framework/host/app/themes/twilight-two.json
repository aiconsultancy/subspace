{
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "name": "Twilight Two",
  "author": "Subspace",
  "_note": "The workspace shell mock-ups' look: a warm near-black canvas, one warm dark surface for the docks, tab strip, title bar and status bar, and Twilight's gold accent. Sizes follow the mock-ups: 32 px rows with the selection inset 8 px and 6 px corners, text 16 px in from every panel edge, 34 px strips, a 36 px toolbar with 24 px controls, a 38 px title bar with 26 px Space tabs, 14 px body text and 12.5 px code. Syntax and other colours the mock-ups do not show are adapted from Twilight in the GPUI Component theme catalogue (Apache License 2.0).",
  "themes": [
    {
      "name": "Twilight Two",
      "mode": "dark",
      "font.family": "Inter",
      "mono_font.family": "JetBrains Mono",
      "radius": 6,
      "radius.lg": 8,
      "shadow": true,
      "subspace": {
        "version": 1,
        "fonts": { "heading": "Inter", "body": "Inter", "mono": "JetBrains Mono" },
        "groupHeading": { "font": "", "size": 13, "bold": true, "italic": false },
        "density": {
          "--heading-font": "16px",
          "--row-font": "14px",
          "--mono-font": "12.5px",
          "--tab-font": "14px",
          "--row-h": "32px",
          "--pad-x": "8px",
          "--indent": "24px",
          "--row-inset": "8px",
          "--chrome-h": "38px",
          "--toolbar-h": "36px",
          "--strip-h": "34px",
          "--nav-w": "240px",
          "--inspector-w": "320px",
          "--radius": "6px",
          "--surface-radius": "8px",
          "--nav-round": "1fr",
          "--toolbar-button-h": "24px",
          "--toolbar-button-pad-x": "9px",
          "--toolbar-button-font": "13.5px",
          "--toolbar-button-radius": "6px",
          "--action-button-h": "22px",
          "--action-button-pad-x": "8px",
          "--action-button-font": "13px",
          "--action-button-radius": "6px",
          "--dialog-button-h": "24px",
          "--dialog-button-pad-x": "12px",
          "--dialog-button-font": "14px",
          "--dialog-button-radius": "6px",
          "--compact-button-h": "20px",
          "--compact-button-pad-x": "4px",
          "--compact-button-font": "12.5px",
          "--compact-button-radius": "5px",
          "--nav-h": "26px",
          "--liquid-glass": "0",
          "--toolbar-button-rest": "flat",
          "--toolbar-button-hover": "flat"
        },
        "tones": {
          "media-stage": "#111110",
          "accent": "#cfa95e",
          "red": "#ef6f66",
          "orange": "#e0a94a",
          "yellow": "#e2c47e",
          "green": "#a3bd6c",
          "blue": "#8aa4c8",
          "cyan": "#8a989b",
          "magenta": "#c49bc0",
          "button-on": "#cfa95e29",
          "glass": "#ffffff1f",
          "glass-rim": "#ffffff4d",
          "glass-shadow": "#00000099"
        }
      },
      "colors": {
        "background": "#131312",
        "foreground": "#d6d3cc",
        "border": "#2b2a27",
        "window.border": "#2b2a27",
        "ring": "#cfa95e",
        "caret": "#f0eee9",
        "accent.background": "#2e2b22",
        "accent.foreground": "#f0eee9",
        "muted.background": "#201f1d",
        "muted.foreground": "#96938a",
        "primary.background": "#cfa95e",
        "primary.hover.background": "#d8b56f",
        "primary.active.background": "#c29c52",
        "primary.foreground": "#17150f",
        "secondary.background": "#201f1d",
        "secondary.hover.background": "#2b2a27",
        "secondary.active.background": "#34322d",
        "secondary.foreground": "#d6d3cc",
        "danger.background": "#ef6f66",
        "danger.hover.background": "#f2837b",
        "danger.active.background": "#e05d54",
        "danger.foreground": "#17150f",
        "warning.background": "#e2c47e",
        "warning.foreground": "#17150f",
        "success.background": "#a3bd6c",
        "success.foreground": "#17150f",
        "info.background": "#8a989b",
        "info.foreground": "#17150f",
        "input.border": "#34322d",
        "link": "#cfa95e",
        "link.hover": "#e6c888",
        "link.active": "#e6c888",
        "list.background": "#131312",
        "list.active.background": "#2e2b22",
        "list.active.border": "#2e2b22",
        "list.even.background": "#131312",
        "list.head.background": "#131312",
        "list.hover.background": "#201f1d",
        "popover.background": "#201f1d",
        "popover.foreground": "#d6d3cc",
        "group_box.background": "#201f1d",
        "group_box.foreground": "#d6d3cc",
        "sidebar.background": "#1a1a18",
        "sidebar.foreground": "#d6d3cc",
        "sidebar.border": "#2b2a27",
        "sidebar.accent.background": "#2e2b22",
        "sidebar.accent.foreground": "#f0eee9",
        "sidebar.primary.background": "#cfa95e",
        "sidebar.primary.foreground": "#17150f",
        "tab_bar.background": "#1a1a18",
        "tab_bar.segmented.background": "#201f1d",
        "tab.background": "#1a1a18",
        "tab.foreground": "#96938a",
        "tab.active.background": "#131312",
        "tab.active.foreground": "#f0eee9",
        "table.background": "#131312",
        "title_bar.background": "#1a1a18",
        "title_bar.border": "#2b2a27",
        "status_bar.background": "#1a1a18",
        "status_bar.border": "#2b2a27",
        "selection.background": "#cfa95e40",
        "scrollbar.background": "#13131200",
        "scrollbar.thumb.background": "#34322d",
        "scrollbar.thumb.hover.background": "#46443e",
        "switch.background": "#807d75",
        "switch.thumb.background": "#17150f",
        "skeleton.background": "#201f1d",
        "progress.bar.background": "#cfa95e",
        "overlay": "#00000073",
        "base.red": "#ef6f66",
        "base.green": "#a3bd6c",
        "base.yellow": "#e2c47e",
        "base.blue": "#8aa4c8",
        "base.magenta": "#c49bc0",
        "base.cyan": "#8a989b"
      },
      "highlight": {
        "editor.foreground": "#d6d3cc",
        "editor.background": "#201f1d",
        "editor.active_line.background": "#2b2a27",
        "editor.line_number": "#96938a",
        "editor.active_line_number": "#f0eee9",
        "editor.invisible": "#34322d",
        "conflict": "#D2602D",
        "created": "#3f72e2",
        "hidden": "#9E9E9E",
        "hint": "#b283f8",
        "modified": "#B0A878",
        "predictive": "#5D5945",
        "syntax": {
          "attribute": { "color": "#be9a52" },
          "boolean": { "color": "#E1D797" },
          "comment": { "color": "#9E9E9E" },
          "comment.doc": { "color": "#9E9E9E" },
          "constant": { "color": "#E1D797" },
          "constructor": { "color": "#b5af9a" },
          "embedded": { "color": "#CACCCA" },
          "function": { "color": "#E1D797" },
          "keyword": { "color": "#E19773" },
          "link_text": { "color": "#C1834E", "font_style": "normal" },
          "link_uri": { "color": "#939189", "font_style": "italic" },
          "number": { "color": "#E19773" },
          "string": { "color": "#76BA53" },
          "string.escape": { "color": "#76BA53" },
          "string.regex": { "color": "#76BA53" },
          "string.special": { "color": "#E1D797" },
          "string.special.symbol": { "color": "#E1D797" },
          "tag": { "color": "#b5af9a" },
          "text.literal": { "color": "#E1D797" },
          "title": { "color": "#C0834E", "font_weight": 600 },
          "type": { "color": "#C1834E" },
          "property": { "color": "#CACCCA" },
          "variable.special": { "color": "#E19773" }
        }
      }
    }
  ]
}
