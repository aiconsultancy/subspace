{
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "name": "Cupertino",
  "author": "Subspace",
  "_note": "Native macOS library materials: silver and warm grey in light mode, graphite and warm black in dark mode, system blue for selection and focus only. Sizes follow a 4 px grid with 32 px rows, 13 px body text and the system UI font. Buttons follow the macOS 26 control sizes: 24 px Liquid Glass toolbar capsules, 20 px small push buttons for board actions and 24 px regular push buttons in dialogs.",
  "themes": [
    {
      "name": "Cupertino Light",
      "mode": "light",
      "font.family": ".SystemUIFont",
      "mono_font.family": "Menlo",
      "radius": 8,
      "radius.lg": 12,
      "shadow": true,
      "subspace": {
        "version": 1,
        "fonts": { "heading": ".SystemUIFont", "body": ".SystemUIFont", "mono": "Menlo" },
        "groupHeading": { "font": "", "size": 12, "bold": false, "italic": false },
        "density": {
          "--heading-font": "15px",
          "--row-font": "13px",
          "--mono-font": "12.5px",
          "--row-h": "32px",
          "--pad-x": "12px",
          "--indent": "24px",
          "--row-inset": "8px",
          "--head-h": "32px",
          "--chrome-h": "38px",
          "--toolbar-h": "44px",
          "--panel-w": "720px",
          "--motion": "160ms",
          "--radius": "6px",
          "--surface-radius": "12px",
          "--toolbar-button-h": "24px",
          "--toolbar-button-pad-x": "10px",
          "--toolbar-button-font": "13px",
          "--toolbar-button-radius": "12px",
          "--action-button-h": "20px",
          "--action-button-pad-x": "8px",
          "--action-button-font": "11px",
          "--action-button-radius": "6px",
          "--dialog-button-h": "24px",
          "--dialog-button-pad-x": "12px",
          "--dialog-button-font": "13px",
          "--dialog-button-radius": "7px",
          "--compact-button-h": "16px",
          "--compact-button-pad-x": "4px",
          "--compact-button-font": "10px",
          "--compact-button-radius": "5px",
          "--dialog-pad": "20px",
          "--dialog-gap": "12px",
          "--liquid-glass": "1"
        },
        "tones": {
          "media-stage": "#e8e8e5",
          "accent": "#0a84ff",
          "red": "#d93c42",
          "orange": "#c25e00",
          "yellow": "#a16207",
          "green": "#2f9e63",
          "blue": "#0a84ff",
          "cyan": "#0e7f99",
          "magenta": "#9a3fd0",
          "glass": "#ffffffc7",
          "glass-rim": "#ffffff",
          "glass-shadow": "#00000033"
        }
