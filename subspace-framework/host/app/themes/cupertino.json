        "scrollbar.thumb.hover.background": "#bfbfbc",
        "switch.background": "#84847f",
        "switch.thumb.background": "#ffffff",
        "skeleton.background": "#e8e8e5",
        "progress.bar.background": "#0a84ff",
        "overlay": "#00000040",
        "base.red": "#d93c42",
        "base.green": "#2f9e63",
        "base.yellow": "#a16207",
        "base.blue": "#0a84ff",
        "base.magenta": "#9a3fd0",
        "base.cyan": "#0e7f99"
