        "editor.active_line.background": "#e3e3df",
        "editor.line_number": "#8c8b85",
        "editor.active_line_number": "#1d1d1f",
        "editor.invisible": "#d2d2cf",
        "syntax": {
          "comment": { "color": "#707070", "font_style": "italic" },
          "comment_doc": { "color": "#707070", "font_style": "italic" },
          "keyword": { "color": "#9b2393" },
          "preproc": { "color": "#78492a" },
          "string": { "color": "#c41a16" },
          "string.escape": { "color": "#1c00cf" },
