{
  "name": "subspace-api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "auth:member": "bun scripts/member.ts",
    "auth:owner": "bun scripts/pairing-owner.ts",
    "auth:bindings": "bun scripts/provider-bindings.ts",
    "auth:username": "bun scripts/username.ts",
    "auth:dev": "bun scripts/dev-token.ts",
    "seed:demo": "bun scripts/seed-demo.ts",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "openapi": "bun scripts/openapi.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "@effect/sql-pg": "4.1.4",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "jose": "6.2.18",
    "marked": "18.2.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
