# Docker Compose defaults. Use these placeholder values only for local development.
API_PORT=3000
POSTGRES_PORT=5432
POSTGRES_PASSWORD=subspace-local
AUTH_PROVIDERS=dev
ENABLE_DEV_AUTH=true
# DATABASE_POOL_SIZE=10
# SSE_MAX_STREAMS_PER_USER=16
# SSE_MAX_STREAMS=256
DEV_CHANNELS="#subspace"
DEV_IRC_HOST=127.0.0.1
DEV_IRC_PORT=6667
# Optional agent-only listener: a request names a registered agent in X-Subspace-Agent and needs
# no token. Off unless AGENT_PORT is set. Publish it on loopback only, as with API_PORT.
# AGENT_PORT=3001
# AGENT_ORGANISATION=dev:local
# Agents' key credentials on the main listener: the API's public origin, which every agent token
# names in aud. Agent tokens are refused while it is unset.
# AGENT_TOKEN_AUDIENCE=http://127.0.0.1:3000

# Uncomment for a host-run API. Compose supplies its own URL automatically.
# DATABASE_URL=postgresql://subspace:subspace-local@127.0.0.1:5432/subspace

# External providers. Supply the real values through your runtime's secret store.
# AUTH_PROVIDERS=workos,entra
# WORKOS_CLIENT_ID=client_00000000000000000000000000
# WORKOS_ISSUER=https://api.workos.com/
# WORKOS_AUDIENCE=https://api.example.com
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_00000000000000000000000000
# WORKOS_API_KEY=
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
# ENTRA_SCOPE=API.Access
# First sign-in registers an unknown Entra person as a member. Off unless set; guests of the
# tenant are refused unless ENTRA_REGISTER_GUESTS=true.
# AUTO_REGISTER=entra
# ENTRA_REGISTER_GUESTS=false
# An app role on the API's app registration that makes its holders administrators.
# ENTRA_ADMIN_ROLE=Subspace.Admin
# Operator names no person or agent may take as a username, beside the IRC service names.
# RESERVED_USERNAMES=root,operator

# Optional IRC sign-in through the API. The secret signs short-lived IRC credentials, bound to
# one of the IRC servers listed in IRC_AUTH_SERVERS; the hook token and organisation turn on the
# route Ergo's auth-script calls. Each secret is random material of 32 bytes or more, different
# from the other, from a file in production: openssl rand -base64 48
# IRC_CREDENTIAL_SECRET_FILE=/run/secrets/irc-credential-secret
# IRC_AUTH_HOOK_TOKEN_FILE=/run/secrets/irc-auth-hook-token
# IRC_AUTH_ORGANISATION=dev:local
# IRC_AUTH_SERVERS=127.0.0.1:6667

# Local file storage requires no additional credentials.
# STORAGE_DRIVER=local
# STORAGE_PATH=.data/blobs
# STORAGE_DRIVER=s3
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional GitHub integration. Supply the internal organisation UUID for App or webhook credentials.
# GITHUB_ORGANISATION_ID=
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# GITHUB_POLL_INTERVAL_SECONDS=120
# GITHUB_WEBHOOK_SECRET=
